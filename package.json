{
  "name": "skatehubba-monorepo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22.0.0 <23",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "turbo lint",
    "test": "turbo test",
    "verify": "pnpm -w run typecheck && pnpm -w run lint && pnpm -w run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.4",
    "esbuild": "^0.27.3",
    "turbo": "^2.7.6",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.7",
    "drizzle-zod": "0.7.0",
    "zod": "3.23.8"
  },
  "pnpm": {
    "overrides": {
      "drizzle-zod": "0.7.0"
    }
  }
}
