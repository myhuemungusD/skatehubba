# ============================================================================
# SkateHubba MVP — Environment Variables
# Copy to .env and fill in your values
# ============================================================================

# Server
NODE_ENV=development
PORT=3001

# PostgreSQL (Neon)
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Firebase Admin SDK (required in production)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# CORS (comma-separated origins, required in production)
ALLOWED_ORIGINS=http://localhost:3000

# Dev admin bypass (dev/test ONLY — blocked in production)
# DEV_ADMIN_BYPASS=true

# Logging
LOG_LEVEL=info

# Client (Vite — prefix with VITE_)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
